<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#6366f1</item>
        <item name="colorPrimaryDark">#090d16</item>
        <item name="colorAccent">#a855f7</item>
        <item name="android:windowBackground">#090d16</item>
        <item name="android:colorBackground">#090d16</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#090d16</item>
        <item name="android:colorBackground">#090d16</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">#090d16</item>
        <item name="android:colorBackground">#090d16</item>
        <item name="windowSplashScreenBackground">#090d16</item>
    </style>
</resources>